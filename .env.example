# ---------- Mobile app (bundled into the app; PUBLIC values only) ----------
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
EXPO_PUBLIC_LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
EXPO_PUBLIC_APP_NAME=RealLife Live
# Optional: map tiles key (Milestone 5)
EXPO_PUBLIC_MAP_API_KEY=

# ---------- Server only: set with `supabase secrets set`, NEVER in the app ----------
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected into Edge Functions automatically.
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Recording / egress storage (Milestone 5), e.g. an S3-compatible bucket
RECORDING_S3_BUCKET=
RECORDING_S3_REGION=
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET=
RECORDING_S3_ENDPOINT=
# Push notifications (when configured)
EXPO_ACCESS_TOKEN=
# Payments (Milestone 6, only when a provider is chosen)
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=
